# Copy this file to .env.production and replace every CHANGE_ME value.
# Never commit .env.production.

# Compose and image settings
OPEN_WEBUI_BIND_ADDRESS=127.0.0.1
OPEN_WEBUI_PORT=6010
WEBUI_BASE_PATH=/opsmitra
ROOT_PATH=/opsmitra
POSTGRES_HOST_PORT=6020
IMAGE_TAG=manual
BUILD_HASH=manual-production
USE_SLIM=true
APP_UID=1000
APP_GID=1000

# PostgreSQL
POSTGRES_DB=openwebui
POSTGRES_USER=openwebui
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_HEX_VALUE

# Open WebUI security and identity
WEBUI_SECRET_KEY=CHANGE_ME_USE_A_DIFFERENT_LONG_HEX_VALUE
WEBUI_NAME=RDC NOVA
WEBUI_URL=https://suraksha.rdcc.ai/opsmitra
ENABLE_SIGNUP=true
ENABLE_COMMUNITY_SHARING=false
ENABLE_VERSION_UPDATE_CHECK=false
ENABLE_OLLAMA_API=false

# Network and privacy
CORS_ALLOW_ORIGIN=https://suraksha.rdcc.ai
FORWARDED_ALLOW_IPS=127.0.0.1
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SAME_SITE=lax
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Retrieval and Gemini embeddings
VECTOR_DB=chroma
RAG_EMBEDDING_ENGINE=gemini
RAG_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY=CHANGE_ME
RAG_GEMINI_API_KEY=CHANGE_ME_USE_THE_SAME_GEMINI_KEY

# Nova V2 pipe defaults. Admin-panel valve values can override these.
NOVA_MODEL=nova
VALIDATION_MODEL=gemini-3.5-flash-lite
DOMAIN_CHECK_MODEL=gemini-3.5-flash-lite
KNOWLEDGE_BASE_ID=CHANGE_ME
ENABLE_DOMAIN_CHECK=true
ENABLE_WEB_SEARCH=false
TRACE_INCLUDE_CONTENT=false

# LangSmith observability
LANGCHAIN_API_KEY=CHANGE_ME
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=rdc-nova-production
